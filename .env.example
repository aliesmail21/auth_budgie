# ==============================================================================
# Budgie Backend - Environment Configuration
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env or real credentials to version control.
# ==============================================================================

# Application Environment ('development' | 'test' | 'production')
NODE_ENV=development

# Network Server Configuration
PORT=3000
HOST=0.0.0.0

# PostgreSQL Connection String (Local PostgreSQL 17 on Windows)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=<schema>&connection_limit=<limit>&pool_timeout=<seconds>
# Local tuning: connection_limit caps active connections (e.g. 10), pool_timeout sets wait time in seconds (e.g. 20).
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/budgie?schema=public&connection_limit=10&pool_timeout=20"

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed origins. Unrestricted CORS is blocked.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging Level ('fatal' | 'error' | 'warn' | 'info' | 'debug' | 'trace')
LOG_LEVEL=debug

# Rate Limiting (Throttle Protection)
# Window size in milliseconds
RATE_LIMIT_TTL_MS=60000
# Maximum number of requests allowed within the window per client
RATE_LIMIT_MAX=100

# HTTP Request Timeout (in milliseconds)
REQUEST_TIMEOUT_MS=15000

# Swagger / OpenAPI Documentation
# Set to 'true' or 'false'. Defaults to true in development/test, false in production.
SWAGGER_ENABLED=true

# Authentication Configuration
JWT_ACCESS_SECRET=budgie_dev_access_secret_key_minimum_32_characters_long_1234
JWT_ACCESS_EXPIRATION_SECONDS=900
REFRESH_TOKEN_EXPIRATION_DAYS=30

# Email & Notification Configuration ('log' | 'smtp' | 'mock')
APP_URL=http://localhost:3000
EMAIL_FROM=noreply@budgie.app
EMAIL_TRANSPORT=log
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
